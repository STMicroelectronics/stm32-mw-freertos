{{assign 'freertos_instance' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::RTOS:STM32CubeMX2 Config:FreeRTOS")~}}
{{assign 'heap1' false~}}
{{assign 'heap2' false~}}
{{assign 'heap3' false~}}
{{assign 'heap4' false~}}
{{assign 'heap5' false~}}
{{#each @root.freertos_instance~}}
{{assign 'freertos_ctx' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'config'  @root.freertos_ctx.settings.parameters.core.basic.memory_management~}}
{{#with @root.config~}}
{{#if (eq memory_management_schema 'HEAP_1')~}}
{{assign 'heap1' true~}}
{{/if}}
{{#if (eq memory_management_schema 'HEAP_2')~}}
{{assign 'heap2' true~}}
{{/if}}
{{#if (eq memory_management_schema 'HEAP_3')~}}
{{assign 'heap3' true~}}
{{/if}}
{{#if (eq memory_management_schema 'HEAP_4')~}}
{{assign 'heap4' true~}}
{{/if}}
{{#if (eq memory_management_schema 'HEAP_5')~}}
{{assign 'heap5' true~}}
{{/if}}
{{/with}}
{{/each}}
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0"
  xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="2.0.0" date="2026-02-13">
      - First GPDSC FreeRTOS Model Release
    </release>
  </releases>
  <conditions>
    {{~assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="Stream Buffers condition, FreeRTOS Memory Heap condition")}}
    {{{@root.conditions}}}
    <condition id="Stream Buffers condition">
      <description>Stream Buffers condition</description>
{{#if (@root.EnvVarAPI.getVariableValue 'stream_buffers')}}
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="Stream Buffer"/>
{{/if}}
    </condition>
    <condition id="FreeRTOS Memory Heap condition">
      <description>FreeRTOS Memory Heap condition</description>
{{#if (eq heap1 true)}}
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="MemMang" Cvariant="Heap_1"/>
{{/if}}
{{#if (eq heap2 true)}}
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="MemMang" Cvariant="Heap_2"/>
{{/if}}
{{#if (eq heap3 true)}}
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="MemMang" Cvariant="Heap_3"/>
{{/if}}
{{#if (eq heap4 true)}}
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="MemMang" Cvariant="Heap_4"/>
{{/if}}
{{#if (eq heap5 true)}}
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="MemMang" Cvariant="Heap_5"/>
{{/if}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
   {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>