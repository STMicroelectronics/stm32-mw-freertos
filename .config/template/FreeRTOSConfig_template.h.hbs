/* app_freertos_post_sleep function ---------------------------*/
void app_freertos_post_sleep (uint32_t ulExpectedIdleTime);
#endif /* defined(__ICCARM__) || defined(__ARMCC_VERSION) || defined(__GNUC__) */

/* The configPRE_SLEEP_PROCESSING() and configPOST_SLEEP_PROCESSING() macros
allow the application writer to add additional code before and after the MCU is
placed into the low power state respectively. */
#define configPRE_SLEEP_PROCESSING(__x__)                           \
                                       do {                         \
                                         app_freertos_pre_sleep(__x__); \
                                         __x__ = 0;                 \
                                      }while(0)
#define configPOST_SLEEP_PROCESSING      app_freertos_post_sleep

