/**
  * @brief Initializes FreeRTOS kernel objects.
  * @param None
  * @retval int32_t Returns 0 on success, -1 on failure.
  */
int32_t app_synctasks_init (void)
{
{{#each tasks}}
{{~#if (eq memory_allocation 'DYNAMIC')}}
{{~#if (not @root.dynamic_memory_allocation)}}
  BaseType_t ret;
{{assign 'dynamic_memory_allocation' true}}
{{/if}}
{{/if}}
{{/each}}
{{#each tasks}}
  /* {{task_name}} creation-------------------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  ret = xTaskCreate({{entry_function}}, "{{task_name}}", {{task_name}}_stack_size,
                    (void*) {{#if (eq parameter 0)}}NULL{{else}}{{parameter}}{{/if}}, {{task_priority}}, &{{task_name}}_Handle);

  if (ret != pdPASS)
  {
      return -1;
  }
{{else}}
  {{task_name}}_Handle = xTaskCreateStatic({{entry_function}}, "{{task_name}}", {{task_name}}_stack_size,
                                          (void*) {{#if (eq parameter 0)}}NULL{{else}}{{parameter}}{{/if}}, {{task_priority}}, {{control_block_name}}, &{{buffer_name}});

  if ({{task_name}}_Handle == NULL)
  {
      return -1;
  }
{{/if}}

{{/each}}
{{#each queues}}
  /* {{queue_name}} creation-------------------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{queue_name}}_Handle = xQueueCreate({{queue_name}}_buffer_size, sizeof({{lowercase queue_item_size}}));
{{else}}
  {{queue_name}}_Handle = xQueueCreateStatic({{queue_name}}_buffer_size, sizeof({{lowercase queue_item_size}}), {{control_block_name}}, &{{buffer_name}});
{{/if}}

  if ({{queue_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each counting_semaphores}}
  /* {{semaphore_name}} creation---------------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{semaphore_name}}_Handle = xSemaphoreCreateCounting({{max_count}}, {{initial_count}});
{{else}}
  {{semaphore_name}}_Handle = xSemaphoreCreateCountingStatic({{max_count}}, {{initial_count}}, &{{buffer_name}});
{{/if}}

  if ({{semaphore_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each binary_semaphores}}
  /* {{semaphore_name}} creation--------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{semaphore_name}}_Handle = xSemaphoreCreateBinary();
{{else}}
  {{semaphore_name}}_Handle = xSemaphoreCreateBinaryStatic(&{{buffer_name}});
{{/if}}

  if ({{semaphore_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each timers}}
  /* {{timer_name}} creation------------------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{timer_name}}_Handle = xTimerCreate("{{timer_name}}", {{timer_name}}_period, {{#if (eq reload_mode 'PERIODIC')}}pdTRUE{{else}}pdFALSE{{/if}}, (void *) {{#if (eq timer_id 0)}}NULL{{else}}{{timer_id}}{{/if}}, {{callback_function}});
{{else}}
  {{timer_name}}_Handle = xTimerCreateStatic("{{timer_name}}", {{timer_name}}_period, {{#if (eq reload_mode 'PERIODIC')}}pdTRUE{{else}}pdFALSE{{/if}}, (void *) {{#if (eq timer_id 0)}}NULL{{else}}{{timer_id}}{{/if}}, {{callback_function}}, &{{buffer_name}});
{{/if}}

  if ({{timer_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each events}}
  /* {{event_name}} creation-------------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{event_name}}_Handle = xEventGroupCreate();
{{else}}
  {{event_name}}_Handle = xEventGroupCreateStatic(&{{buffer_name}});
{{/if}}

  if ({{event_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each mutexes}}
  /* {{mutex_name}} creation-----------------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{mutex_name}}_Handle = xSemaphoreCreateMutex();
{{else}}
  {{mutex_name}}_Handle = xSemaphoreCreateMutexStatic(&{{buffer_name}});
{{/if}}

  if ({{mutex_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each recursive_mutexes}}
  /* {{recursive_mutex_name}} creation-------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{recursive_mutex_name}}_Handle = xSemaphoreCreateRecursiveMutex();
{{else}}
  {{recursive_mutex_name}}_Handle = xSemaphoreCreateRecursiveMutexStatic(&{{buffer_name}});
{{/if}}

  if ({{recursive_mutex_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each queue_sets}}
  /* {{queue_set_name}} creation-------------------------*/
  {{queue_set_name}}_Handle = xQueueCreateSet({{queue_set_name}}_length);

  if ({{queue_set_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each stream_buffers}}
  /* {{stream_buffer_name}} creation-------------------------*/
{{#if (eq memory_allocation 'DYNAMIC')}}
  {{stream_buffer_name}}_Handle = xStreamBufferCreate({{stream_buffer_name}}_size, {{stream_buffer_name}}_trigger_level);
{{else}}
  {{stream_buffer_name}}_Handle = xStreamBufferCreateStatic({{stream_buffer_name}}_size, {{stream_buffer_name}}_trigger_level, {{buffer_storage}}, &{{stream_buffer_control}});
{{/if}}

  if ({{stream_buffer_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
  return 0;
}

