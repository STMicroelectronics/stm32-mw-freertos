{{#each tasks~}}
/**
  * @brief Function implementing the {{task_name}} thread.
  * @param pvParameters: A pointer to the parameters passed to the task.
  * @retval None
  */
static void {{entry_function}}(void *pvParameters)
{
  ( void ) pvParameters;

  for(;;)
  {
    /* Infinite loop executing {{task_name}} functionality. */
  }
}

